# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
POSTGRES_PASSWORD=change-me
# Platform AI keys (tenants only choose provider/model). Leave empty to disable a provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set true when served over HTTPS
COOKIE_SECURE=false
# Optional system default model. Leave empty: each organization chooses its own model on first use.
# DEFAULT_AI_PROVIDER=
# DEFAULT_AI_MODEL=
